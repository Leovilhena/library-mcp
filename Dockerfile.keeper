# syntax=docker/dockerfile:1
FROM python:3.14-slim AS build

WORKDIR /build
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
RUN pip install --no-cache-dir --target=/install .

FROM python:3.14-slim

# Same uid/gid as library-parse's image, deliberately -- see the comment in
# Dockerfile.parse. Both need read-write access to the same knowledge.db.
RUN groupadd -r libshare --gid=10004 \
    && useradd -r -g libshare --uid=10004 --home-dir=/nonexistent --shell=/usr/sbin/nologin libshare \
    && dpkg --purge --force-depends --force-remove-essential perl-base \
    && ! command -v perl

COPY --from=build --chown=root:root --chmod=555 /install /opt/library

ENV PYTHONPATH=/opt/library \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POLICY_PATH=/policy/keeper.yaml \
    AUDIT_PATH=/audit/audit.jsonl \
    HOST=0.0.0.0 \
    PORT=8804

RUN mkdir -p /audit && chown libshare:libshare /audit && chmod 700 /audit

USER libshare
EXPOSE 8804

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python3 -c "import socket,os,sys; s=socket.create_connection(('127.0.0.1',int(os.environ['PORT'])),3); s.close()" || exit 1

ENTRYPOINT ["python3", "-m", "library_mcp.servers.keeper_server"]
